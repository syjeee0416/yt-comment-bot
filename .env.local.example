# ─── Gemini API (답글 초안 생성) ───
# https://aistudio.google.com/apikey 에서 발급
GEMINI_API_KEY=

# ─── Supabase (DB) ───
# https://supabase.com/dashboard 에서 프로젝트 만든 뒤
# Project Settings → API에서 URL과 키 복사
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── YouTube Data API v3 OAuth ───
# 1) https://console.cloud.google.com → APIs & Services → Library
#    → "YouTube Data API v3" Enable
# 2) APIs & Services → OAuth consent screen
#    → User type: External · App name 입력 · Test users에 본인 구글 계정 추가
# 3) APIs & Services → Credentials → Create credentials → OAuth client ID
#    → Application type: Web application
#    → Authorized redirect URIs: http://localhost:3000/api/yt-auth/callback
#       (배포 후엔 https://<도메인>/api/yt-auth/callback 도 추가)
# 4) 발급된 Client ID / Secret을 아래에 붙여넣기
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=

# 콜백 base URL — 로컬은 http://localhost:3000, Vercel은 https://<도메인>
YOUTUBE_OAUTH_REDIRECT_BASE=http://localhost:3000
